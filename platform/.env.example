# development | staging | production. Defaults to production for production builds.
HB_ENV=development
# 1 = show sample data labels and banner (never in production)
HB_DEMO=1
# Postgres connection string. Leave empty locally to use the embedded database in .data/pg.
DATABASE_URL=
# Set to 0 to hide the simulated sandbox supplier outside production.
HB_SANDBOX_SUPPLIER=1
# Claude API key for the AI tools (server only). Leave empty to switch them off.
ANTHROPIC_API_KEY=
# Secret the scheduler sends to /api/cron (Bearer token, 16+ characters). Without it the jobs never run.
CRON_SECRET=
# Email (Resend). Without both, emails are recorded as "not sent". Outside production also set EMAIL_ALLOW_NONPROD=1.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
# Public address of this app, used in links inside emails (e.g. https://portal.hotelbridge.co)
APP_URL=
